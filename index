<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Service Performance Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--navy:#153d68;--navy2:#0f2f52;--blue:#2f79b9;--bg:#f3f6fa;--card:#fff;--line:#d7e0eb;--text:#102a49;--muted:#667085;--green:#118c4f;--amber:#d97706;--red:#c92a22}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
header{background:linear-gradient(120deg,var(--navy2),#24649b);color:#fff;padding:28px 34px 24px}
.header-row{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;max-width:1550px;margin:auto}
h1{font-size:34px;margin:0 0 4px;letter-spacing:-.6px}.subtitle{font-size:18px;opacity:.9}
.upload-row{display:flex;gap:10px;align-items:end}.upload-control{min-width:215px}
.upload-control label{display:block;font-size:12px;margin-bottom:6px;opacity:.9;font-weight:700}
.upload-btn,select{width:100%;background:#fff;border:0;border-radius:10px;padding:11px 13px;font:inherit;color:#173858}
.upload-btn{cursor:pointer;font-weight:700}.upload-btn.loaded{color:var(--green)}
input[type=file]{display:none}
nav{background:#fff;border-bottom:1px solid var(--line);padding:9px 34px}
.nav-inner{max-width:1550px;margin:auto;display:flex;gap:8px;flex-wrap:wrap}
.tab{border:0;background:transparent;color:#667085;padding:10px 15px;border-radius:9px;font-weight:700;cursor:pointer}
.tab.active{background:#e7f0fa;color:#205f97}
.wrap{max-width:1550px;margin:auto;padding:28px 34px}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:14px}.section-head h2{font-size:25px;margin:0 0 3px}.section-head p{margin:0;color:var(--muted)}
.period{color:var(--muted);font-size:14px}
.cards-top{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.cards-small{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 5px 16px rgba(16,42,73,.04)}
.card.hero{min-height:145px}.card.hero.primary{background:linear-gradient(135deg,#173e69,#24629a);color:#fff;border-color:transparent}
.label{font-size:12px;letter-spacing:.04em;text-transform:uppercase;font-weight:800;color:#667085}.primary .label{color:#d6e7f7}
.value{font-size:34px;font-weight:800;margin-top:12px;line-height:1}.small-card .value{font-size:31px}
.detail{font-size:13px;color:var(--muted);margin-top:11px}.primary .detail{color:#dceaf6}
.status{font-size:13px;font-weight:800;margin-top:12px}.status.good{color:var(--green)}.status.wait{color:var(--red)}.primary .status{color:#fff}
.content{display:none}.content.active{display:block}
.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;margin-top:18px}
.panel h3{font-size:21px;margin:0 0 4px}.panel p{margin:0 0 14px;color:var(--muted)}
.table-wrap{overflow:auto;max-height:520px}table{width:100%;border-collapse:collapse;font-size:13px}th{background:#edf3f8;text-align:left;padding:10px;color:#344054;position:sticky;top:0}td{padding:10px;border-bottom:1px solid #e8edf3}
tr:nth-child(even) td{background:#fbfcfe}
.highlight-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.highlight{background:#edf5fd;border-left:4px solid var(--blue);border-radius:10px;padding:12px;font-size:14px}
.notice{display:none;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;padding:12px;border-radius:10px;margin-bottom:16px}
@media(max-width:1100px){.header-row{display:block}.upload-row{margin-top:18px;flex-wrap:wrap}.cards-top,.cards-small{grid-template-columns:repeat(2,1fr)}}
@media(max-width:650px){.wrap,nav,header{padding-left:15px;padding-right:15px}.cards-top,.cards-small,.highlight-grid{grid-template-columns:1fr}h1{font-size:27px}.upload-control{min-width:100%}}
</style>
</head>
<body>
<header>
<div class="header-row">
<div><h1>Service Performance Dashboard</h1><div class="subtitle">Daily operational view with retained monthly history</div></div>
<div class="upload-row">
<div class="upload-control">
<label>End of Day report</label>
<label class="upload-btn" id="eodButton" for="eodFile">Upload End of Day</label>
<input id="eodFile" type="file" accept=".xls,.xlsx,.xlsm">
</div>
<div class="upload-control">
<label>Service capture workbook</label>
<label class="upload-btn" id="captureButton" for="captureFile">Upload service workbook</label>
<input id="captureFile" type="file" accept=".xlsx,.xls,.xlsm">
</div>
<div class="upload-control">
<label>Reporting month</label>
<select id="monthSelect"><option>July 2026</option></select>
</div>
</div>
</div>
</header>

<nav><div class="nav-inner">
<button class="tab active" data-target="dashboard">Dashboard</button>
<button class="tab" data-target="advisors">Advisors</button>
<button class="tab" data-target="technicians">Technicians</button>
<button class="tab" data-target="citnow">Weekly CitNOW</button>
<button class="tab" data-target="archive">Monthly archive</button>
</div></nav>

<div class="wrap">
<div class="notice" id="notice"></div>

<section id="dashboard" class="content active">
<div class="section-head"><div><h2>Management headlines</h2><p>Only the measures that need immediate management attention.</p></div><div class="period" id="periodLabel">July 2026 · Month to date</div></div>

<div class="cards-top">
<div class="card hero primary"><div class="label">Service GP run rate</div><div class="value" id="serviceGpRunRate">£0</div><div class="detail">Forecast month-end position</div><div class="status" id="serviceGpStatus">● Awaiting data</div></div>
<div class="card hero"><div class="label">CitNOW sent</div><div class="value" id="citnowSent">0</div><div class="detail">Month-to-date headline volume</div><div class="status wait" id="citnowStatus">● Awaiting data</div></div>
<div class="card hero"><div class="label">Service plan sales</div><div class="value" id="servicePlanSales">0</div><div class="detail" id="servicePlanHeroDetail">Sales during selected month</div><div class="status wait" id="servicePlanStatus">● Awaiting data</div></div>
</div>

<div class="cards-small">
<div class="card small-card"><div class="label">Service GP actual</div><div class="value" id="serviceGpActual">£0</div><div class="detail">Current month actual</div></div>
<div class="card small-card"><div class="label">CitNOW watched</div><div class="value" id="citnowWatched">0.0%</div><div class="detail" id="citnowDetail">Headline centre watch rate</div></div>
<div class="card small-card"><div class="label">Technician efficiency</div><div class="value" id="efficiency">0.0%</div><div class="detail">Sold hours ÷ attended hours</div></div>
<div class="card small-card"><div class="label">Parts GP</div><div class="value" id="partsGp">£0</div><div class="detail">Current month actual</div></div>
<div class="card small-card"><div class="label">Tyres sold</div><div class="value" id="tyres">0</div><div class="detail">Advisor total</div></div>
<div class="card small-card"><div class="label">Geometry sold</div><div class="value" id="geometry">0</div><div class="detail">Advisor total</div></div>
<div class="card small-card"><div class="label">Fuel treatment</div><div class="value" id="fuelRate">0.0%</div><div class="detail" id="fuelDetail">Sold ÷ opportunities</div></div>
<div class="card small-card"><div class="label">Service plans</div><div class="value" id="servicePlanRate">0.0%</div><div class="detail" id="servicePlanDetail">Sold ÷ opportunities</div></div>
</div>

<div class="panel"><h3>Advisor month-to-date activity</h3><p>Daily entries roll into this selected-month view.</p><div class="table-wrap">
<table><thead><tr><th>Advisor</th><th>Retail visits</th><th>CitNOW sent</th><th>ACS</th><th>Geometry</th><th>Tyres</th><th>Fuel</th><th>SP quotes</th><th>SP sales</th><th>CRS</th><th>Returns</th></tr></thead><tbody id="dashboardAdvisorRows"><tr><td colspan="11">Upload the service workbook.</td></tr></tbody></table>
</div></div>

<div class="panel"><h3>Highlights & attention</h3><p>Automatic management commentary from the uploaded files.</p><div class="highlight-grid" id="highlights"><div class="highlight">Upload both files to populate the dashboard.</div></div></div>
</section>

<section id="advisors" class="content"><div class="panel"><h3>Advisor performance</h3><p>Selected-month totals from the service capture workbook.</p><div class="table-wrap"><table><thead><tr><th>Advisor</th><th>Retail visits</th><th>CitNOW sent</th><th>ACS</th><th>Geometry</th><th>Tyres</th><th>Fuel opps</th><th>Fuel sold</th><th>SP opps</th><th>SP quotes</th><th>SP sales</th><th>CRS</th><th>Returns</th></tr></thead><tbody id="advisorRows"></tbody></table></div></div></section>
<section id="technicians" class="content"><div class="panel"><h3>Technician performance</h3><p>Selected-month totals from the service capture workbook.</p><div class="table-wrap"><table><thead><tr><th>Technician</th><th>Attended hours</th><th>Sold hours</th><th>Efficiency</th><th>Labour sales</th></tr></thead><tbody id="technicianRows"></tbody></table></div></div></section>
<section id="citnow" class="content"><div class="panel"><h3>Weekly CitNOW</h3><p>Weekly advisor sent, watched and watch-rate performance.</p><div class="table-wrap"><table><thead><tr><th>Advisor</th><th>Week 1</th><th>Week 2</th><th>Week 3</th><th>Week 4</th><th>Week 5</th><th>Total</th></tr></thead><tbody id="citnowRows"></tbody></table></div></div></section>
<section id="archive" class="content"><div class="panel"><h3>Monthly archive</h3><p>Choose any month contained in the uploaded service capture workbook.</p><div id="archiveButtons"></div></div></section>
</div>

<script>
let eodWB=null,captureWB=null;
const money=v=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP',maximumFractionDigits:0}).format(Number(v)||0);
const num=v=>new Intl.NumberFormat('en-GB',{maximumFractionDigits:0}).format(Number(v)||0);
const pct=v=>`${((Number(v)||0)*100).toFixed(1)}%`;
const n=v=>Number(v)||0;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function sheetRows(wb,name){return wb&&wb.Sheets[name]?XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,defval:'',raw:true}):[]}
function cell(a,r,c){return a[r-1]?.[c-1]??''}
function sumRow(a,row,start=3,end=33){let s=0;for(let c=start;c<=end;c++)s+=n(cell(a,row,c));return s}
function avgPositiveRow(a,row,start=3,end=33){const v=[];for(let c=start;c<=end;c++){const x=n(cell(a,row,c));if(x>0)v.push(x)}return v.length?v.reduce((x,y)=>x+y,0)/v.length:0}
function selectedSheet(){return document.getElementById('monthSelect').value}
function setNotice(msg){const el=document.getElementById('notice');el.style.display=msg?'block':'none';el.textContent=msg||''}

function populateMonths(){
 if(!captureWB)return;
 const months=captureWB.SheetNames.filter(x=>/^(January|February|March|April|May|June|July|August|September|October|November|December) \d{4}$/.test(x));
 const sel=document.getElementById('monthSelect');sel.innerHTML='';
 months.forEach(m=>{const o=document.createElement('option');o.value=m;o.textContent=m;sel.appendChild(o)});
 if(months.includes('July 2026'))sel.value='July 2026';
 document.getElementById('archiveButtons').innerHTML=months.map(m=>`<button class="tab ${m===sel.value?'active':''}" onclick="document.getElementById('monthSelect').value='${m}';render();">${m}</button>`).join('');
}
function captureData(){
 const name=selectedSheet(),a=sheetRows(captureWB,name);if(!a.length)return null;
 const advisors=[];
 for(const start of [31,44,57,70]){
   const adviser=String(cell(a,start,1)||'').trim();if(!adviser)continue;
   advisors.push({
     name:adviser,visits:sumRow(a,start),citnow:sumRow(a,start+1),acs:sumRow(a,start+2),geometry:sumRow(a,start+3),tyres:sumRow(a,start+4),
     fuelOpp:sumRow(a,start+5),fuelSales:sumRow(a,start+6),spOpp:sumRow(a,start+7),spQuotes:sumRow(a,start+8),spSales:sumRow(a,start+9),
     crs:avgPositiveRow(a,start+10),returns:sumRow(a,start+11)
   });
 }
 const technicians=[];
 for(let start=86;start<=126;start+=4){
   const tech=String(cell(a,start,1)||'').trim();if(!tech)continue;
   const attended=sumRow(a,start),sold=sumRow(a,start+1),labour=sumRow(a,start+3);
   technicians.push({name:tech,attended,sold,eff:attended?sold/attended:0,labour});
 }
 const watched=sumRow(a,8),sent=advisors.reduce((s,x)=>s+x.citnow,0);
 const tyres=advisors.reduce((s,x)=>s+x.tyres,0),geometry=advisors.reduce((s,x)=>s+x.geometry,0);
 const fuelOpp=advisors.reduce((s,x)=>s+x.fuelOpp,0),fuelSales=advisors.reduce((s,x)=>s+x.fuelSales,0);
 const spOpp=advisors.reduce((s,x)=>s+x.spOpp,0),spQuotes=advisors.reduce((s,x)=>s+x.spQuotes,0),spSales=advisors.reduce((s,x)=>s+x.spSales,0);
 const attended=technicians.reduce((s,x)=>s+x.attended,0),sold=technicians.reduce((s,x)=>s+x.sold,0);
 const serviceGp=sumRow(a,10),partsGp=sumRow(a,11);
 const citnowWeekly=[];
 for(let r=134;r<=137;r++){const adv=String(cell(a,r,1)||'').trim();if(!adv)continue;let weeks=[];for(let c=3;c<=17;c+=3){const s=n(cell(a,r,c)),w=n(cell(a,r,c+1));weeks.push({s,w,rate:s?w/s:0})}citnowWeekly.push({name:adv,weeks});}
 return {name,a,advisors,technicians,watched,sent,watchRate:sent?watched/sent:0,tyres,geometry,fuelOpp,fuelSales,fuelRate:fuelOpp?fuelSales/fuelOpp:0,spOpp,spQuotes,spSales,spRate:spOpp?spSales/spOpp:0,attended,sold,eff:attended?sold/attended:0,serviceGp,partsGp,citnowWeekly};
}
function eodData(){
 if(!eodWB)return null;
 const month=selectedSheet().split(' ')[0].toUpperCase(), aliases={JANUARY:['JAN','JANUARY'],FEBRUARY:['FEB','FEBRUARY'],MARCH:['MAR','MARCH'],APRIL:['APR','APRIL'],MAY:['MAY'],JUNE:['JUN','JUNE'],JULY:['JUL','JULY'],AUGUST:['AUG','AUGUST'],SEPTEMBER:['SEP','SEPT','SEPTEMBER'],OCTOBER:['OCT','OCTOBER'],NOVEMBER:['NOV','NOVEMBER'],DECEMBER:['DEC','DECEMBER']}[month]||[];
 const s=eodWB.SheetNames.find(x=>aliases.includes(x.toUpperCase()));if(!s)return null;
 const a=sheetRows(eodWB,s);
 return {days:n(cell(a,3,5))||1,total:n(cell(a,4,5))||31,servicePlan:n(cell(a,17,3)),serviceActual:n(cell(a,17,5)),partsPlan:n(cell(a,26,3)),partsActual:n(cell(a,26,5))};
}
function render(){
 if(!captureWB){setNotice('Upload the service capture workbook to populate advisor, technician and CitNOW data.');return}
 const c=captureData();if(!c){setNotice('The selected month sheet could not be read.');return}
 const e=eodData();setNotice(!eodWB?'Upload the End of Day report to populate Service GP and Parts GP from Daryl’s report.':'');
 const serviceActual=e?e.serviceActual:c.serviceGp,partsActual=e?e.partsActual:c.partsGp,runRate=e?serviceActual*e.total/e.days:serviceActual;
 document.getElementById('periodLabel').textContent=c.name+' · Month to date';
 document.getElementById('serviceGpRunRate').textContent=money(runRate);
 document.getElementById('serviceGpActual').textContent=money(serviceActual);
 document.getElementById('partsGp').textContent=money(partsActual);
 document.getElementById('citnowSent').textContent=num(c.sent);
 document.getElementById('citnowWatched').textContent=pct(c.watchRate);
 document.getElementById('citnowDetail').textContent=`${num(c.watched)} watched from ${num(c.sent)} sent`;
 document.getElementById('efficiency').textContent=pct(c.eff);
 document.getElementById('tyres').textContent=num(c.tyres);
 document.getElementById('geometry').textContent=num(c.geometry);
 document.getElementById('fuelRate').textContent=pct(c.fuelRate);
 document.getElementById('fuelDetail').textContent=`${num(c.fuelSales)} sold from ${num(c.fuelOpp)} opportunities`;
 document.getElementById('servicePlanSales').textContent=num(c.spSales);
 document.getElementById('servicePlanRate').textContent=pct(c.spRate);
 document.getElementById('servicePlanHeroDetail').textContent=`${num(c.spSales)} sales from ${num(c.spOpp)} opportunities`;
 document.getElementById('servicePlanDetail').textContent=`${num(c.spSales)} sold · ${num(c.spQuotes)} quoted · ${num(c.spOpp)} opportunities`;
 document.getElementById('serviceGpStatus').textContent=e?`● Forecast ${money(runRate)} against plan ${money(e.servicePlan)}`:'● Using service capture workbook';
 document.getElementById('citnowStatus').className='status '+(c.sent?'good':'wait');document.getElementById('citnowStatus').textContent=c.sent?'● Data loaded':'● Awaiting data';
 document.getElementById('servicePlanStatus').className='status '+(c.spSales?'good':'wait');document.getElementById('servicePlanStatus').textContent=c.spSales?'● Data loaded':'● Awaiting data';
 const advisorHtml=c.advisors.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${num(x.visits)}</td><td>${num(x.citnow)}</td><td>${num(x.acs)}</td><td>${num(x.geometry)}</td><td>${num(x.tyres)}</td><td>${num(x.fuelSales)} / ${num(x.fuelOpp)}</td><td>${num(x.spQuotes)}</td><td>${num(x.spSales)}</td><td>${x.crs?x.crs.toFixed(1):'-'}</td><td>${num(x.returns)}</td></tr>`).join('');
 document.getElementById('dashboardAdvisorRows').innerHTML=advisorHtml;
 document.getElementById('advisorRows').innerHTML=c.advisors.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${num(x.visits)}</td><td>${num(x.citnow)}</td><td>${num(x.acs)}</td><td>${num(x.geometry)}</td><td>${num(x.tyres)}</td><td>${num(x.fuelOpp)}</td><td>${num(x.fuelSales)}</td><td>${num(x.spOpp)}</td><td>${num(x.spQuotes)}</td><td>${num(x.spSales)}</td><td>${x.crs?x.crs.toFixed(1):'-'}</td><td>${num(x.returns)}</td></tr>`).join('');
 document.getElementById('technicianRows').innerHTML=c.technicians.sort((a,b)=>b.eff-a.eff).map(x=>`<tr><td><strong>${esc(x.name)}</strong></td><td>${x.attended.toFixed(1)}</td><td>${x.sold.toFixed(1)}</td><td>${pct(x.eff)}</td><td>${money(x.labour)}</td></tr>`).join('');
 document.getElementById('citnowRows').innerHTML=c.citnowWeekly.map(x=>`<tr><td><strong>${esc(x.name)}</strong></td>${x.weeks.map(w=>`<td>${num(w.w)} / ${num(w.s)} (${pct(w.rate)})</td>`).join('')}<td>${num(x.weeks.reduce((s,w)=>s+w.w,0))} / ${num(x.weeks.reduce((s,w)=>s+w.s,0))}</td></tr>`).join('')||'<tr><td colspan="7">No weekly CitNOW entries found.</td></tr>';
 const topAdv=[...c.advisors].sort((a,b)=>b.spSales-a.spSales)[0],topTech=[...c.technicians].sort((a,b)=>b.eff-a.eff)[0],highReturns=[...c.advisors].sort((a,b)=>b.returns-a.returns)[0];
 const highlights=[
 topAdv?`${esc(topAdv.name)} leads service-plan sales with <strong>${num(topAdv.spSales)}</strong>.`:'No service-plan sales entered.',
 topTech?`${esc(topTech.name)} is the top technician at <strong>${pct(topTech.eff)}</strong> efficiency.`:'No technician hours entered.',
 `CitNOW is at <strong>${pct(c.watchRate)}</strong>: ${num(c.watched)} watched from ${num(c.sent)} sent.`,
 `Fuel treatment conversion is <strong>${pct(c.fuelRate)}</strong>: ${num(c.fuelSales)} from ${num(c.fuelOpp)} opportunities.`,
 highReturns&&highReturns.returns?`${esc(highReturns.name)} has the highest customer returns at <strong>${num(highReturns.returns)}</strong>.`:'No customer returns recorded.',
 e?`Service GP forecast is <strong>${money(runRate)}</strong> against a plan of ${money(e.servicePlan)}.`:'End of Day report not yet loaded.'
 ];
 document.getElementById('highlights').innerHTML=highlights.map(x=>`<div class="highlight">${x}</div>`).join('');
}
async function loadFile(file,type){
 try{const wb=XLSX.read(await file.arrayBuffer(),{type:'array',cellDates:true});if(type==='eod'){eodWB=wb;document.getElementById('eodButton').textContent=file.name;document.getElementById('eodButton').classList.add('loaded')}else{captureWB=wb;document.getElementById('captureButton').textContent=file.name;document.getElementById('captureButton').classList.add('loaded');populateMonths()}render()}catch(err){setNotice('The spreadsheet could not be read: '+err.message)}
}
document.getElementById('eodFile').addEventListener('change',e=>e.target.files[0]&&loadFile(e.target.files[0],'eod'));
document.getElementById('captureFile').addEventListener('change',e=>e.target.files[0]&&loadFile(e.target.files[0],'capture'));
document.getElementById('monthSelect').addEventListener('change',render);
document.querySelectorAll('.tab[data-target]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.tab[data-target]').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.content').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.target).classList.add('active')}));
</script>
</body>
</html>
